  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 39,
    "stages": [
      {
        "template-tags": {
          "start_date": {
            "display-name": "Start Date",
            "default": "2025-09-12",
            "type": "date",
            "name": "start_date",
            "id": "a76b1cdc-1d22-4832-adcd-a4b15058e8cf",
            "widget-type": null
          },
          "end_date": {
            "display-name": "End Date",
            "default": "2026-03-12",
            "type": "date",
            "name": "end_date",
            "id": "ddf5f89d-5764-4594-9077-650163c1b069",
            "widget-type": null
          }
        },
        "lib/type": "mbql.stage/native",
        "native": "with dates as (\nselect date_trunc('month',full_date) as \"month\", min(full_date) as month_start_date, max(full_date) month_end_date, date_add('day',-1,min(full_date)) as prev_month_end_date\nfrom dwh_curefit.dim_date\nwhere full_date between {{start_date}} and {{end_date}}\ngroup by 1\n)\n\n-- select * from dates\n\nselect \nd.\"month\"\n, case when is_enterprise = 1 then md.business_line||' (B2B)' else md.business_line end as business_line\n,city_name\n,count(distinct user_id) as user_base\nfrom dates d\nleft join (\nselect membership_key, md.business_line, membership_created_date, pack_start_date, pack_end_date, is_enterprise, amount_paid, pack_name, user_id, cd.city_name, cancellation_date\nfrom dwh_fitness_mart.membership_dim md \nleft join dwh_fitness_mart.center_dim cd on cd.center_key=coalesce(attributed_center_key,final_center_key,purchase_center_key,last_30_days_preferred_center_key)\n\nwhere 1=1\nand UPPER(md.business_line) not like '%PT%' -- users of PT are counted in ELITE/PRO memberships\n\nand md.business_line is not null\n) md\non d.month_end_date between md.pack_start_date and least(coalesce(md.cancellation_date,pack_end_date),md.pack_end_date)\ngroup by 1,2,3\norder by 1 desc, 3 desc"
      }
    ]
  },
  "dimension_mappings": null,
  "id": 77280,
  "legacy_query": "{\"database\":39,\"type\":\"native\",\"native\":{\"template-tags\":{\"start_date\":{\"type\":\"date\",\"name\":\"start_date\",\"id\":\"a76b1cdc-1d22-4832-adcd-a4b15058e8cf\",\"display-name\":\"Start Date\",\"default\":\"2025-09-12\",\"widget-type\":null},\"end_date\":{\"type\":\"date\",\"name\":\"end_date\",\"id\":\"ddf5f89d-5764-4594-9077-650163c1b069\",\"display-name\":\"End Date\",\"default\":\"2026-03-12\",\"widget-type\":null}},\"query\":\"with dates as (\\nselect date_trunc('month',full_date) as \\\"month\\\", min(full_date) as month_start_date, max(full_date) month_end_date, date_add('day',-1,min(full_date)) as prev_month_end_date\\nfrom dwh_curefit.dim_date\\nwhere full_date between {{start_date}} and {{end_date}}\\ngroup by 1\\n)\\n\\n-- select * from dates\\n\\nselect \\nd.\\\"month\\\"\\n, case when is_enterprise = 1 then md.business_line||' (B2B)' else md.business_line end as business_line\\n,city_name\\n,count(distinct user_id) as user_base\\nfrom dates d\\nleft join (\\nselect membership_key, md.business_line, membership_created_date, pack_start_date, pack_end_date, is_enterprise, amount_paid, pack_name, user_id, cd.city_name\\nfrom dwh_fitness_mart.membership_dim md \\nleft join dwh_fitness_mart.center_dim cd on cd.center_key=coalesce(attributed_center_key,final_center_key,purchase_center_key,last_30_days_preferred_center_key)\\n\\nwhere lower(status) not like '%canc%'\\n-- and ((amount_paid > 0) --or (lower(source) <> 'enterprise_split' and is_enterprise = 1)\\n-- )\\nand md.business_line is not null\\n) md\\non d.month_end_date between md.pack_start_date and md.pack_end_date\\ngroup by 1,2,3\\norder by 1 desc, 3 desc\"}}",
