      "query": "SELECT 'CROSS-SELL', ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member= 1\n      AND is_cancelled = 0\n      AND channel = 'EBO'\n      [[AND {{category}}]]\n      [[AND {{cohort}}]]\n      [[AND {{service_type}}]]\n      [[AND {{store_name}}]]\n     [[ AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}} ]]\n     \nUNION ALL \n\nSELECT 'NON-FS-MEMBER', ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member= 0\n      AND is_cancelled = 0\n      AND channel = 'EBO'\n      [[AND {{category}}]]\n      [[AND {{cohort}}]]\n      [[AND {{service_type}}]]\n      [[AND {{store_name}}]]\n     [[ AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}} ]]"
    }
