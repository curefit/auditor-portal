        "date_of_month_start_date": {
          "type": "number",
          "name": "date_of_month_start_date",
          "id": "72250b63-dba0-464e-96e4-5254e8418b52",
          "display-name": "Date Of Month Start Date"
        },
        "date_of_month_end_date": {
          "type": "number",
          "name": "date_of_month_end_date",
          "id": "5c50099c-9c79-4e32-93a6-6175d2c4a019",
          "display-name": "Date Of Month End Date"
        }
      },
      "query": "WITH fs_cohorts AS \n(\n    SELECT *\n    FROM \n    dwh_fitness_metrics.fs_cohorts\n    WHERE 1 = 1\n    AND month = DATE_TRUNC('MONTH', CURRENT_DATE)\n    AND \n        CASE \n            WHEN {{compare_with_current_month}} = 1 THEN 1 = 1 [[ AND DATE_TRUNC('MONTH',first_membership_created_date) >= DATE_TRUNC('MONTH', CURRENT_DATE - INTERVAL  '1' MONTH * {{no_of_month}}) ]]\n            ELSE 1 = 1 [[ AND DATE_TRUNC('MONTH',first_membership_created_date) BETWEEN DATE_TRUNC('MONTH',{{month_start_date}}) AND DATE_TRUNC('MONTH', {{month_end_date}}) ]]\n        END\n    AND \n        CASE\n            WHEN {{compare_with_current_date}} = 1 THEN DAY(first_membership_created_date) < DAY(CURRENT_DATE)\n            ELSE 1 = 1 [[ AND DAY(first_membership_created_date) BETWEEN {{date_of_month_start_date}} AND {{date_of_month_end_date}} ]]\n        END\n)\n\nSELECT DATE_TRUNC('MONTH',first_membership_created_date) AS month, COUNT(DISTINCT user_id) AS user_count\nFROM \nfs_cohorts\nGROUP BY 1\nORDER BY 1"
    }
  },
