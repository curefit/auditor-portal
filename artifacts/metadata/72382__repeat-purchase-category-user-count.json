        "is_freebie_order": {
          "type": "dimension",
          "name": "is_freebie_order",
          "id": "c1f0268d-b7f7-45d2-8362-6034253e374b",
          "display-name": "Is Freebie Order",
          "default": null,
          "dimension": [
