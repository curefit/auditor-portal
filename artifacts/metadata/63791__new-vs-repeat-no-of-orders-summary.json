      },
      "query": "SELECT 'NEW' AS new_vs_repeat, COUNT(DISTINCT unique_order_id) AS total_orders\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND order_rnk = 1\n      AND order_date >= DATE('2018-01-01')\n      AND is_cancelled = 0\n     [[AND {{source}}]]\n     [[AND {{category}}]]\n     [[AND {{cohort}}]]\n     [[AND {{service_type}}]]\n     [[AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}}]]\n\nUNION ALL \n\nSELECT 'REPEAT' AS new_vs_repeat, COUNT(DISTINCT unique_order_id) AS total_orders\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND order_rnk <> 1\n      AND order_date >= DATE('2018-01-01')\n      AND is_cancelled = 0\n     [[AND {{source}}]]\n     [[AND {{category}}]]\n     [[AND {{cohort}}]]\n     [[AND {{service_type}}]]\n     [[AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}}]]\n    \n"
    }
