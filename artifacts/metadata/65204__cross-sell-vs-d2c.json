      "query": "SELECT 'CROSS-SELL' AS cross_sell_vs_1p, ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n     AND is_fs_member= 1\n     AND order_date >= DATE('2018-01-01')\n     AND is_cancelled = 0 \n     [[AND {{source}}]]\n     [[AND {{category}}]]\n     [[AND {{cohort}}]]\n     [[AND {{service_type}}]]\n     [[AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}}]]\n\nUNION ALL \n\nSELECT 'NON-FS-MEMBER' AS cross_sell_vs_1p, ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n     AND is_fs_member= 0\n     AND is_cancelled = 0\n     AND order_date >= DATE('2018-01-01')\n     [[AND {{source}}]]\n     [[AND {{category}}]]\n     [[AND {{cohort}}]]\n     [[AND {{service_type}}]]\n     [[AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}}]] \n"
    }
