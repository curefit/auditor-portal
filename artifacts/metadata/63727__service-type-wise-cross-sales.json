      },
      "query": "WITH final_data AS \n(\n    SELECT majority_service, ROUND(SUM(gmv)) AS total_gmv\n    FROM dwh_fitness_metrics.cross_sell_orders\n    WHERE TRUE\n          AND is_fs_member = 1\n          AND order_date >= DATE('2018-01-01')\n          AND is_cancelled = 0\n         [[AND {{source}}]]\n         [[AND {{category}}]]\n         [[AND {{cohort}}]]\n         [[AND {{service_type}}]]\n         [[AND order_date BETWEEN {{start_order_date}} AND {{end_order_date}}]]\n    GROUP BY 1\n)\n\nSELECT majority_service, total_gmv, total_gmv * 1.000/SUM(total_gmv) OVER() AS percentage\nFROM \nfinal_data\nORDER BY 2 DESC"
    }
  },
