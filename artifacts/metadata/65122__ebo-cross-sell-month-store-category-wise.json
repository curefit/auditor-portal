      },
      "query": "SELECT DATE_TRUNC('MONTH',order_date) AS month, store_name, category, COUNT(DISTINCT order_id) AS order_count, ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE channel = 'EBO'\nAND is_fs_member = 1\nAND is_cancelled = 0\n[[AND {{store_name}}]]\n[[AND {{category}}]]\n[[AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}}]]\nGROUP BY 1,2,3\nORDER BY 4 DESC\n"
    }
  },
