      },
      "query": "SELECT category, COUNT(DISTINCT order_id) AS order_count, ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE channel = 'EBO'\n[[AND {{category}}]]\n[[AND {{cohort}}]]\n[[AND {{service_type}}]]\n[[AND {{store_name}}]]\nAND is_fs_member = 1\nAND is_cancelled = 0\n[[AND order_date BETWEEN {{order_start_date}} AND {{order_end_date}}]]\nGROUP BY 1\nORDER BY 1,2,3\n"
    }
  },
