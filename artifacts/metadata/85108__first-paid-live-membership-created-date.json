    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT\n    MIN(membership_created_date) AS first_paid_live_membership_created_date\nFROM dwh_fitness_mart.membership_fact\nWHERE business_line = 'LIVE'\n  AND COALESCE(amount_paid, 0) > 0\n  AND transaction_date = date('2026-06-16')"
      }
    ]
  },
