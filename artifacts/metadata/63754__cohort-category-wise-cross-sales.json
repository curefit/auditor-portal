      "query": "SELECT cohort, category, ROUND(SUM(gmv)) AS total_gmv\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member = 1\n      AND is_cancelled = 0\n     [[AND {{cohort}}]]\n     [[AND {{category}}]]\n     [[AND order_date BETWEEN {{start_order_date}} AND {{end_order_date}}]]\nGROUP BY 1,2\nORDER BY 1, 3 DESC"
    }
