          75683
        ],
        "lib/type": "mbql.stage/native",
        "query": "SELECT \n    CONCAT(\n    CASE\n      WHEN MONTH(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) BETWEEN 1 AND 3  THEN 'Q1'\n      WHEN MONTH(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) BETWEEN 4 AND 6  THEN 'Q2'\n      WHEN MONTH(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) BETWEEN 7 AND 9  THEN 'Q3'\n      ELSE 'Q4'\n    END,\n    '-',\n    CAST(YEAR(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) AS VARCHAR)\n  ) AS quarter_year,\n  YEAR(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) AS year,\n  CASE\n      WHEN MONTH(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) BETWEEN 1 AND 3  THEN 1\n      WHEN MONTH(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) BETWEEN 4 AND 6  THEN 2\n      WHEN MONTH(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) BETWEEN 7 AND 9  THEN 3\n      ELSE 4\n  END AS quarter,\n  ROUND(SUM(CAST(REPLACE(total_amount, ',', '') AS DOUBLE))) AS total_amount, ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) AS base_amount,\n  ROUND(SUM(nlc)) AS total_nlc,\n  SUM(CAST(REPLACE(quantity_invoiced, ',', '') AS DOUBLE)) AS units,\n  ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) - ROUND(SUM(nlc)) AS gm,\n  (ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) - ROUND(SUM(nlc))) * 1.000/ ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) AS gm_percent\nFROM (SELECT *\nFROM stage_dwh.dwh_d2c_metrics_bizfin_sales_data)\nWHERE 1 = 1 \n\n\n\n AND DATE(DATE_PARSE(invoice_date, '%d-%m-%Y')) BETWEEN ? AND ? \n\nGROUP BY 1, 2, 3\nORDER BY 1, 2 ,3"
      },
