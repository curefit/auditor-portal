        "lib/type": "mbql.stage/native",
        "query": "SELECT 'Active' AS active_vs_expired, ROUND(SUM(gmv)) AS total_gmv\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND cohort NOT LIKE '%Expired%'\n      AND order_date >= DATE('2018-01-01')\n      AND is_cancelled = 0\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n     AND order_date BETWEEN ? AND ?\n\nUNION ALL \n\nSELECT 'Expired' AS active_vs_expired, ROUND(SUM(gmv)) AS total_gmv\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND cohort LIKE '%Expired%'\n      AND order_date >= DATE('2018-01-01')\n      AND is_cancelled = 0\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n     AND order_date BETWEEN ? AND ?"
