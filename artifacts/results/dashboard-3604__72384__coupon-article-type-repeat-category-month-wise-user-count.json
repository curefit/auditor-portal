          "lib/type": "mbql.stage/native",
          "template-tags": {
            "order_start_date": {
              "id": "e1fc21d8-d7fa-4384-bce1-54579a481d37",
              "type": "date",
              "name": "order_start_date",
              "display-name": "Order Start Date"
            },
            "order_end_date": {
