        "lib/type": "mbql.stage/native",
        "query": "SELECT 'NEW' AS new_vs_repeat, ROUND(SUM(gmv)) AS total_gmv\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND order_rnk = 1\n      AND order_date >= DATE('2018-01-01')\n      AND is_cancelled = 0\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n     AND order_date BETWEEN ? AND ?\n\nUNION ALL \n\nSELECT 'REPEAT' AS new_vs_repeat, ROUND(SUM(gmv)) AS total_gmv\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND order_rnk <> 1\n      AND order_date >= DATE('2018-01-01')\n      AND is_cancelled = 0\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n     AND order_date BETWEEN ? AND ?"
