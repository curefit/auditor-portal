          "Indoor_Equipment-Strength",
          "2023-04-01",
          "2026-03-31"
        ],
        "lib/type": "mbql.stage/native",
        "query": "WITH combined_data AS \n(\n    SELECT 'CROSS-SELL' AS member_type,store_name, ROUND(SUM(gmv)) AS gmv\n    FROM \n    dwh_fitness_metrics.cross_sell_orders\n    WHERE TRUE\n         AND is_fs_member= 1\n         AND is_cancelled = 0\n         AND channel = 'EBO'\n         AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n         \n         \n         \n         AND order_date BETWEEN ? AND ? \n    GROUP BY 1,2\n         \n    UNION ALL \n    \n    SELECT 'NON-FS-MEMBER' AS member_type,store_name, ROUND(SUM(gmv)) AS gmv\n    FROM \n    dwh_fitness_metrics.cross_sell_orders\n    WHERE TRUE\n         AND is_fs_member= 0\n         AND is_cancelled = 0\n         AND channel = 'EBO'\n         AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n         \n         \n         \n          AND order_date BETWEEN ? AND ?  \n    GROUP BY 1,2\n)\n\nSELECT \n    member_type,\n    store_name,\n    gmv\nFROM combined_data\nORDER BY \n    SUM(gmv) OVER (PARTITION BY store_name) DESC, \n    store_name"
      },
      "pivot-export-options": {
