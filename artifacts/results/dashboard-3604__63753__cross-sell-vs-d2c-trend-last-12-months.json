      "native_form": {
        "params": [
          "Month",
          "Month",
          "Month",
          "Month",
          "Month",
          "Month",
          "Indoor Equipment",
          "Indoor_Equipment-Strength",
          "2023-04-01",
          "2026-03-31"
        ],
        "lib/type": "mbql.stage/native",
        "query": "WITH final_data AS \n(\n    SELECT \n        CASE \n            WHEN ? = 'Year' THEN CAST(year(order_date) AS VARCHAR)\n            WHEN ? = 'Month' THEN format_datetime(order_date, 'MMMM') || ' - ' || CAST(year(order_date) AS VARCHAR)\n            WHEN ? = 'Quarter' THEN 'Q' || CAST(quarter(order_date) AS VARCHAR) || ' - ' || CAST(year(order_date) AS VARCHAR)\n        END AS order_date,\n        CASE\n            WHEN ? = 'Year' THEN date_trunc('year', order_date)\n            WHEN ? = 'Month' THEN date_trunc('month', order_date)\n            WHEN ? = 'Quarter' THEN date_trunc('quarter', order_date)\n        END AS sort_key,\n        CASE \n            WHEN is_fs_member = 0 THEN 'NON-FS MEMBER'\n            WHEN is_fs_member = 1 THEN 'CROSS-SELL'\n        END AS is_fs_member,\n        ROUND(SUM(gmv)) AS gmv\n    FROM dwh_fitness_metrics.cross_sell_orders\n    WHERE TRUE\n          \n          AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n          \n          \n          AND is_cancelled = 0\n          AND CASE \n                WHEN 1 = 1 THEN order_date BETWEEN DATE_TRUNC('MONTH',CURRENT_DATE) - INTERVAL '13' MONTH AND DATE_TRUNC('MONTH',CURRENT_DATE) - INTERVAL '1' DAY\n                ELSE 1 = 0 AND order_date BETWEEN ? AND ?\n              END\n    GROUP BY 1,2,3\n)\n\nSELECT *, gmv/SUM(gmv) OVER(PARTITION BY order_date) AS percentage, ROUND(SUM(gmv) OVER(PARTITION BY order_date)) AS total_gmv\nFROM final_data\nORDER BY sort_key"
      },
      "pivot-export-options": {
        "show-row-totals": true,
        "show-column-totals": true
      },
