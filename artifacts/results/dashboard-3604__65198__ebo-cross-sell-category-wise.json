        "lib/type": "mbql.stage/native",
        "query": "SELECT category, COUNT(DISTINCT order_id) AS order_count, ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE channel = 'EBO'\nAND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n\n\n\nAND is_fs_member = 1\nAND is_cancelled = 0\nAND order_date BETWEEN ? AND ?\nGROUP BY 1\nORDER BY 1,2,3"
