        "lib/type": "mbql.stage/native",
        "query": "SELECT 'NEW' AS new_vs_repeat,\n        CASE \n            WHEN ? = 'Year' THEN CAST(year(order_date) AS VARCHAR)\n            WHEN ? = 'Month' THEN format_datetime(order_date, 'MMMM') || ' - ' || CAST(year(order_date) AS VARCHAR)\n            WHEN ? = 'Quarter' THEN 'Q' || CAST(quarter(order_date) AS VARCHAR) || ' - ' || CAST(year(order_date) AS VARCHAR)\n        END AS order_date,\n        CASE\n            WHEN ? = 'Year' THEN date_trunc('year', order_date)\n            WHEN ? = 'Month' THEN date_trunc('month', order_date)\n            WHEN ? = 'Quarter' THEN date_trunc('quarter', order_date)\n        END AS sort_key,\n        COUNT(DISTINCT order_id) AS total_orders\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND order_rnk = 1\n      AND is_cancelled = 0\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n      AND CASE \n            WHEN 1 = 1 THEN order_date BETWEEN DATE_TRUNC('MONTH',CURRENT_DATE) - INTERVAL '13' MONTH AND DATE_TRUNC('MONTH',CURRENT_DATE) - INTERVAL '1' DAY\n            ELSE 1 = 0 AND order_date BETWEEN ? AND ?\n          END\nGROUP BY 1,2,3\n\n\nUNION ALL \n\nSELECT 'REPEAT' AS new_vs_repeat, \n        CASE \n            WHEN ? = 'Year' THEN CAST(year(order_date) AS VARCHAR)\n            WHEN ? = 'Month' THEN format_datetime(order_date, 'MMMM') || ' - ' || CAST(year(order_date) AS VARCHAR)\n            WHEN ? = 'Quarter' THEN 'Q' || CAST(quarter(order_date) AS VARCHAR) || ' - ' || CAST(year(order_date) AS VARCHAR)\n        END AS order_date,\n        CASE\n            WHEN ? = 'Year' THEN date_trunc('year', order_date)\n            WHEN ? = 'Month' THEN date_trunc('month', order_date)\n            WHEN ? = 'Quarter' THEN date_trunc('quarter', order_date)\n        END AS sort_key,\n        COUNT(DISTINCT order_id) AS total_orders\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member  = 1\n      AND order_rnk <> 1\n      AND is_cancelled = 0\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n      AND CASE \n            WHEN 1 = 1 THEN order_date BETWEEN DATE_TRUNC('MONTH',CURRENT_DATE) - INTERVAL '13' MONTH AND DATE_TRUNC('MONTH',CURRENT_DATE) - INTERVAL '1' DAY\n            ELSE 1 = 0 AND order_date BETWEEN ? AND ?\n          END\nGROUP BY 1,2,3\n\n\nORDER BY 3"
      },
