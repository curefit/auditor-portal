        "lib/type": "mbql.stage/native",
        "query": "SELECT ROUND(SUM(CAST(REPLACE(total_amount, ',', '') AS DOUBLE))) AS total_amount, ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) AS base_amount, ROUND(SUM(nlc)) AS total_nlc,\nSUM(CAST(REPLACE(quantity_invoiced, ',', '') AS DOUBLE)) AS units,\nROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) - ROUND(SUM(nlc)) AS gm,\n(ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) - ROUND(SUM(nlc))) * 1.000/ ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) AS gm_percent\nFROM (SELECT *\nFROM stage_dwh.dwh_d2c_metrics_bizfin_sales_data)\nWHERE 1 = 1 \n\n\n\n AND DATE(DATE_PARSE(invoice_date, '%d-%m-%Y')) BETWEEN ? AND ?"
