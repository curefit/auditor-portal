        "lib/type": "mbql.stage/native",
        "query": "SELECT \n    CASE\n        WHEN MONTH(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) >= 4\n            THEN CONCAT(\n                CAST(YEAR(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) AS VARCHAR),\n                '-',\n                CAST(YEAR(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) + 1 AS VARCHAR)\n            )\n        ELSE CONCAT(\n                CAST(YEAR(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) - 1 AS VARCHAR),\n                '-',\n                CAST(YEAR(DATE(DATE_PARSE(invoice_date, '%d-%m-%Y'))) AS VARCHAR)\n            )\n    END AS financial_year,\n  ROUND(SUM(CAST(REPLACE(total_amount, ',', '') AS DOUBLE))) AS total_amount, ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) AS base_amount,\n  ROUND(SUM(nlc)) AS total_nlc,\n  SUM(CAST(REPLACE(quantity_invoiced, ',', '') AS DOUBLE)) AS units,\n  ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) - ROUND(SUM(nlc)) AS gm,\n  (ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) - ROUND(SUM(nlc))) * 1.000/ ROUND(SUM(CAST(REPLACE(base_amount, ',', '') AS DOUBLE))) AS gm_percent\nFROM (SELECT *\nFROM stage_dwh.dwh_d2c_metrics_bizfin_sales_data)\nWHERE 1 = 1 \n\n\n\n AND DATE(DATE_PARSE(invoice_date, '%d-%m-%Y')) BETWEEN ? AND ? \n\nGROUP BY 1\nORDER BY 1"
      },
