            "center_name": {
              "widget-type": "string/=",
              "id": "39d5e3c1-82ac-e777-fc46-c7afd8010e3b",
              "name": "center_name",
              "display-name": "Center name",
              "type": "dimension",
              "dimension": [
                "field",
                {
                  "lib/uuid": "462e9b2f-cd7b-4c62-9c72-5876b08e3bae",
                  "lib/transformation-added-base-type": true,
                  "base-type": "type/Text",
