          "parsed-query": [
            "WITH age_calculated AS \n(\n    SELECT CASE \n            WHEN birthday != 'NO-BIRTHDAY' THEN DATE_DIFF('MONTH',DATE(CAST(birthday AS TIMESTAMP)),order_date)/12 \n            ELSE NULL\n            END AS age, \n            user_id, category, gmv\n    FROM \n    dwh_fitness_metrics.cross_sell_orders\n    WHERE is_fs_member = 1\n        AND order_date >= DATE('2018-01-01')\n        AND is_cancelled = 0\n      ",
            {
              "args": [
                "AND ",
                {
                  "k": "source"
                }
              ]
            },
            "\n      ",
            {
              "args": [
                "AND ",
                {
                  "k": "category"
                }
              ]
            },
