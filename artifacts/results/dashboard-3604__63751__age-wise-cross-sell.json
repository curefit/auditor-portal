              "args": [
                "AND ",
                {
                  "k": "service_type"
                }
              ]
            },
            "\n      ",
            {
              "args": [
                " AND order_date BETWEEN ",
                {
                  "k": "order_start_date"
                },
                " AND ",
                {
                  "k": "order_end_date"
                }
              ]
            },
            "\n),\n\nfinal_data AS\n(\n    SELECT CASE     WHEN age IS NULL THEN 'NO-AGE'\n                    WHEN CAST(age AS DECIMAL) <= 10 THEN '0-10'\n                    WHEN CAST(age AS DECIMAL) > 10 and CAST(age AS DECIMAL) <= 20 THEN '11-20'\n                    WHEN CAST(age AS DECIMAL) > 20 and CAST(age AS DECIMAL) <= 30 THEN '21-30'\n                    WHEN CAST(age AS DECIMAL) > 30 and CAST(age AS DECIMAL) <= 40 THEN '31-40'\n                    WHEN CAST(age AS DECIMAL) > 40 and CAST(age AS DECIMAL) <= 50 THEN '41-50'\n                    WHEN CAST(age AS DECIMAL) > 50 THEN '50+'\n                END AS age,\n            COUNT(DISTINCT user_id) AS user_count,\n            ROUND(SUM(gmv)) AS total_gmv\n    FROM age_calculated\n    GROUP BY 1\n)\n\nSELECT age, total_gmv, total_gmv * 1.000/SUM(total_gmv) OVER() AS percentage\nFROM \nfinal_data\nORDER BY 2 DESC"
          ]
        }
