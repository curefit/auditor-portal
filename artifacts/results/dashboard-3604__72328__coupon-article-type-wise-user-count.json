        "query": "SELECT article_type, COUNT(distinct user_id) AS user_count\nFROM dwh_fitness_metrics.cross_sell_orders\n    WHERE is_freebie_order = 1\n            AND order_date >= DATE('2018-01-01')\n            AND 1 = 1\n            AND (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"is_freebie_order\" = 1)\n            AND order_date BETWEEN ? AND ?\nGROUP BY 1\nORDER BY 2 DESC"
