        "lib/type": "mbql.stage/native",
        "query": "WITH combined_data AS \n(\n    SELECT 'CROSS-SELL' AS member_type,category, ROUND(SUM(gmv)) AS gmv\n    FROM \n    dwh_fitness_metrics.cross_sell_orders\n    WHERE TRUE\n         AND is_fs_member= 1\n         AND is_cancelled = 0\n         AND order_date >= DATE('2018-01-01')\n         \n         AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n         \n         \n         AND order_date BETWEEN ? AND ? \n    GROUP BY 1,2\n         \n    UNION ALL \n    \n    SELECT 'NON-FS-MEMBER' AS member_type,category, ROUND(SUM(gmv)) AS gmv\n    FROM \n    dwh_fitness_metrics.cross_sell_orders\n    WHERE TRUE\n         AND is_fs_member= 0\n         AND is_cancelled = 0\n         AND order_date >= DATE('2018-01-01')\n         \n         AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n         \n         \n          AND order_date BETWEEN ? AND ?  \n    GROUP BY 1,2\n)\n\nSELECT \n    member_type,\n    category,\n    gmv\nFROM combined_data\nORDER BY \n    SUM(gmv) OVER (PARTITION BY category) DESC, \n    category"
      },
