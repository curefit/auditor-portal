          "native": "WITH fs_cohorts AS \n(\n    SELECT *\n    FROM \n    dwh_fitness_metrics.fs_cohorts\n    WHERE 1 = 1\n    AND month = DATE_TRUNC('MONTH', CURRENT_DATE)\n    AND \n        CASE \n            WHEN {{compare_with_current_month}} = 1 THEN 1 = 1 [[ AND DATE_TRUNC('MONTH',first_membership_created_date) >= DATE_TRUNC('MONTH', CURRENT_DATE - INTERVAL  '1' MONTH * {{no_of_month}}) ]]\n            ELSE 1 = 1 [[ AND DATE_TRUNC('MONTH',first_membership_created_date) BETWEEN DATE_TRUNC('MONTH',{{month_start_date}}) AND DATE_TRUNC('MONTH', {{month_end_date}}) ]]\n        END\n    AND \n        CASE\n            WHEN {{compare_with_current_date}} = 1 THEN DAY(first_membership_created_date) < DAY(CURRENT_DATE)\n            ELSE 1 = 1 [[ AND DAY(first_membership_created_date) BETWEEN {{date_of_month_start_date}} AND {{date_of_month_end_date}} ]]\n        END\n)\n\nSELECT DATE_TRUNC('MONTH',first_membership_created_date) AS month, business_line, COUNT(DISTINCT user_id) AS user_count\nFROM \nfs_cohorts\nGROUP BY 1, 2\nORDER BY 1, 3 DESC"
