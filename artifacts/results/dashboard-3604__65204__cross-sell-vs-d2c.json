        "query": "SELECT 'CROSS-SELL' AS cross_sell_vs_1p, ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n     AND is_fs_member= 1\n     AND order_date >= DATE('2018-01-01')\n     AND is_cancelled = 0 \n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n     AND order_date BETWEEN ? AND ?\n\nUNION ALL \n\nSELECT 'NON-FS-MEMBER' AS cross_sell_vs_1p, ROUND(SUM(gmv)) AS total_gmv\nFROM \ndwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n     AND is_fs_member= 0\n     AND is_cancelled = 0\n     AND order_date >= DATE('2018-01-01')\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     \n     \n     AND order_date BETWEEN ? AND ?"
