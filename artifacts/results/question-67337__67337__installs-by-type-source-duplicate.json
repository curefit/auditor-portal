          "2026-03-31"
        ],
        "lib/type": "mbql.stage/native",
        "query": "Select\n    \"Date\",\n    \"Install Type - Source\",\n    Case\n        When ? = 'Users' Then \"Users\"\n        When ? = 'Devices' Then \"Devices\"\n        When ? = 'Installs' Then \"Installs\"\n    End as \"Installs\"\nFrom\n(\n    SELECT\n      Date_Trunc (?, install_date) AS \"Date\",\n      user_install_type || ' - ' || source AS \"Install Type - Source\",\n      COUNT(DISTINCT user_id) AS \"Users\",\n      COUNT(DISTINCT device_id) AS \"Devices\",\n      COUNT(DISTINCT primary_key) AS \"Installs\"\n    FROM\n      dwh_growth_mart.growth_install_fact \n    WHERE\n      install_date BETWEEN ? AND ?\n      and fitness_membership_type='Non-Member'\n      AND 1 = 1\n      AND 1 = 1\n      and 1 = 1\n    GROUP BY\n      1,\n      2\n)\n\n\nUNION ALL \n\nSelect\n    \"Date\",\n    'TOTAL',\n    SUM(Case\n        When ? = 'Users' Then \"Users\"\n        When ? = 'Devices' Then \"Devices\"\n        When ? = 'Installs' Then \"Installs\"\n    End ) as \"Installs\"\nFrom\n(\n    SELECT\n      Date_Trunc (?, install_date) AS \"Date\",\n      user_install_type || ' - ' || source AS \"Install Type - Source\",\n      COUNT(DISTINCT user_id) AS \"Users\",\n      COUNT(DISTINCT device_id) AS \"Devices\",\n      COUNT(DISTINCT primary_key) AS \"Installs\"\n    FROM\n      dwh_growth_mart.growth_install_fact\n    WHERE\n      install_date BETWEEN ? AND ?\n      and fitness_membership_type='Non-Member'\n      AND 1 = 1\n      AND 1 = 1\n    GROUP BY\n      1,\n      2\n)\ngroup by 1,2\nORDER BY\n  1 DESC"
      },
