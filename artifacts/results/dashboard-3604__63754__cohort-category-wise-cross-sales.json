        "lib/type": "mbql.stage/native",
        "query": "SELECT cohort, category, ROUND(SUM(gmv)) AS total_gmv\nFROM dwh_fitness_metrics.cross_sell_orders\nWHERE TRUE\n      AND is_fs_member = 1\n      AND is_cancelled = 0\n     \n     AND ((\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?) OR (\"dwh_fitness_metrics\".\"cross_sell_orders\".\"category\" = ?))\n     AND order_date BETWEEN ? AND ?\nGROUP BY 1,2\nORDER BY 1, 3 DESC"
      },
