# Optional: used only by `scripts/generate-catalog.mjs` (Node, at build time — not bundled into the app).
# Copy to `.env` in this repository root and adjust.

# Public Metabase host for links to questions/cards.
METABASE_SITE_URL=https://metabase.curefit.co

# dbt project on GitHub (read-only tree + raw file URLs). Use either form:
#   curefit/dbt-data-models
#   https://github.com/curefit/dbt-data-models
DBT_GITHUB_REPO=

# Branch or tag name for the GitHub tree API.
DBT_GITHUB_REF=main

# Path prefix inside the repo where dbt model SQL files live (default: models).
# e.g. transformatics/models for curefit/dbt-data-models
DBT_MODELS_PATH=models

# Fallback repo searched when a table has no match in the primary dbt repo.
# Expects Jupyter notebooks named schema.table_name.ipynb (e.g. cf-data-lab/nbs/pinaka_data_models).
FALLBACK_GITHUB_REPO=
FALLBACK_GITHUB_REF=master
FALLBACK_MODELS_PATH=nbs/pinaka_data_models

# Optional: raises GitHub API rate limits and allows private repos for the build step only.
GITHUB_TOKEN=
